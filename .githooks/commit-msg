#!/usr/bin/env bash
set -euo pipefail

commit_msg_file="${1:-}"

if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
  exit 1
fi

python - "$commit_msg_file" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")

def is_copilot_coauthor(line: str) -> bool:
    lowered = line.lstrip().lower()
    return lowered.startswith("co-authored-by:") and "copilot" in lowered

filtered_lines = [line for line in text.splitlines() if not is_copilot_coauthor(line)]

result = "\n".join(filtered_lines)
if text.endswith("\n"):
    result += "\n"

path.write_text(result, encoding="utf-8")
PY
