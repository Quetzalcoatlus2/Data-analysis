LOG_LEVEL="DEBUG"
DELETE_UPLOADED_AFTER_PROCESSING=true
HOST="127.0.0.1"
PORT="5000"
FLASK_DEBUG="1"
FLASK_ENV = "development"
USE_TALISMAN=1
ENABLE_SECURITY_HEADERS="true"
RATE_LIMIT="120/hour"
DEFAULT_FORECAST_STEPS="240"
DEFAULT_CONTAMINATION="0.02"
FULL_HISTORY_MAX_POINTS=all
GENAI_MODEL="models/gemini-2.5-pro"
AI_TIMEOUT_SECONDS = "25"
AI_RETRY_ATTEMPTS = "3"
AI_RETRY_BACKOFF_SECONDS = "1.5"
