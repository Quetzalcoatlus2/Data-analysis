LOG_LEVEL="DEBUG"
DELETE_UPLOADED_AFTER_PROCESSING=true
HOST="127.0.0.1"
PORT="5000"
FLASK_DEBUG="1"
FLASK_ENV = "development"
USE_TALISMAN=1
ENABLE_SECURITY_HEADERS="true"
RATE_LIMIT="120/hour"
DEFAULT_FORECAST_STEPS="240"
DEFAULT_CONTAMINATION="0.02"
FULL_HISTORY_MAX_POINTS=all

# ===== AI Configuration =====
# Default model - use gemini-2.5-flash for free tier
GENAI_MODEL="models/gemini-2.5-flash"

# Timeout settings - increase for slower connections or large datasets
AI_TIMEOUT_SECONDS=120
AI_RETRY_ATTEMPTS=2
AI_RETRY_BACKOFF_SECONDS=5.0

# File upload to Gemini - DISABLE (set to 0) to prevent timeouts and rate limits
# Large file uploads can cause timeouts and consume quota quickly
AI_FULL_UPLOAD_MAX_MB=0

# View time budgets - time allowed for page rendering before deferring AI
OVERVIEW_TIME_BUDGET_SEC=45
FORECAST_TIME_BUDGET_SEC=90

# Defer AI summary on first overview load to prevent quota exhaustion
# Set to 1 to defer, 0 to always generate (may hit rate limits)
OVERVIEW_DEFER_AI_SUMMARY=0
