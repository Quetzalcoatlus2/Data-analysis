# SECRET_KEY="<set-in-local-.env>"
# GOOGLE_API_KEY="<set-in-local-.env>"
LOG_LEVEL="DEBUG"
DELETE_UPLOADED_AFTER_PROCESSING=true
# UPLOAD_RETENTION_DAYS=1
HOST="127.0.0.1"
PORT="5000"
FLASK_DEBUG="1"
USE_TALISMAN=1
ENABLE_SECURITY_HEADERS="true"
RATE_LIMIT="120/hour"
DEFAULT_FORECAST_STEPS="40"
DEFAULT_CONTAMINATION="0.02"
