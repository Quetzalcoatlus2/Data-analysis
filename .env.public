# SECRET_KEY="<set-in-local-.env>"
# GOOGLE_API_KEY="<set-in-local-.env>"
LOG_LEVEL="DEBUG"
DELETE_UPLOADED_AFTER_PROCESSING=true
# UPLOAD_RETENTION_DAYS=1
HOST="127.0.0.1"
PORT="5000"
FLASK_DEBUG="1"
FLASK_ENV = "development"
USE_TALISMAN=1
ENABLE_SECURITY_HEADERS="true"
RATE_LIMIT="120/hour"
DEFAULT_FORECAST_STEPS="240"
DEFAULT_CONTAMINATION="0.02"
FULL_HISTORY_MAX_POINTS=all
AI_TIMEOUT_SECONDS = "25"
AI_RETRY_ATTEMPTS = "3"
AI_RETRY_BACKOFF_SECONDS = "1.5"
